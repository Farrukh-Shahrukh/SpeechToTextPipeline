<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Lets the app run on .NET 9/10 if only a newer runtime is installed -->
  <RollForward>Major</RollForward>
    <!-- No unsigned .exe launcher: run through the Microsoft-signed dotnet host instead.
         Avoids "An Application Control policy has blocked this file" (Smart App Control / WDAC). -->
    <UseAppHost>false</UseAppHost>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TranscriptionPipeline</RootNamespace>
    <AssemblyName>TranscriptionPipeline</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <!-- CPU runtime. Swap for Whisper.net.Runtime.Cuda (NVIDIA) or add Whisper.net.Runtime.CoreML (Apple) -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
